{
  "name": "@cubecroom/docs",
  "version": "0.1.0",
  "private": true,
  "description": "دليل CubeCroom للمعلم والطالب: شروح مركزية ولقطات موثّقة.",
  "scripts": {
    "dev": "node ../../scripts/brand.mjs --check && next dev --port 4320",
    "build": "node ../../scripts/brand.mjs --check && node ../../scripts/guide.mjs && next build",
    "start": "next start --port 4320",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@cubecroom/ui": "workspace:*",
    "fumadocs-core": "^15.8.5",
    "fumadocs-mdx": "^12.0.3",
    "fumadocs-ui": "^15.8.5",
    "lucide-react": "^0.475.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "license": "AGPL-3.0-only"
}
