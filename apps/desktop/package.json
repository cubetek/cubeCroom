{
  "name": "@cubecroom/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "قشرة Electron: دورة الحياة، التخزين الآمن، خادم الطلاب المحلي، وتغليف التطبيق.",
  "main": "dist-app/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n next,electron -c cyan,green \"pnpm --filter @cubecroom/teacher-ui dev\" \"pnpm dev:electron\"",
    "dev:electron": "node ../../scripts/bundle-desktop.mjs && wait-on tcp:3000 && node ../../scripts/dev-desktop.mjs",
    "rebuild:electron": "node ../../scripts/rebuild-native.mjs electron",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "wdio run wdio.conf.mjs"
  },
  "devDependencies": {
    "@cubecroom/ai": "workspace:*",
    "@cubecroom/contracts": "workspace:*",
    "@cubecroom/core": "workspace:*",
    "@cubecroom/db": "workspace:*",
    "@types/node": "^22.10.5",
    "@wdio/cli": "^9.9.1",
    "@wdio/local-runner": "^9.9.1",
    "@wdio/mocha-framework": "^9.9.0",
    "@wdio/spec-reporter": "^9.9.0",
    "concurrently": "^9.1.2",
    "electron": "44.2.0",
    "esbuild": "^0.19.12",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.2",
    "wdio-electron-service": "^8.0.2",
    "webdriverio": "^9.9.1"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9",
    "yaml": "2.9.0"
  },
  "productName": "CubeCroom",
  "license": "AGPL-3.0-only"
}
