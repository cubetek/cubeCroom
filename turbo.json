{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["scripts/brand.mjs", "packages/ui/assets/brand/**", "apps/desktop/build/icon.*"],
  "tasks": {
    "@cubecroom/docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/guide.mjs", "$TURBO_ROOT$/scripts/guide-copy.mjs", "$TURBO_ROOT$/scripts/guide/**", "$TURBO_ROOT$/scripts/release/config.mjs"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**", ".source/**", "content/docs/**"]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**",
        "out-next/**",
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".source/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    }
  }
}
