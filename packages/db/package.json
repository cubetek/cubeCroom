{
  "name": "@cubecroom/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "مخطط SQLite والترحيلات والمستودعات — تُستعمل من عملية Electron الرئيسية فقط.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@cubecroom/contracts": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "^0.38.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.7.3"
  },
  "license": "AGPL-3.0-only"
}
